+// ObjectStore: the single source of truth for drawn objects on the board or a PDF.
+// - Local edits are recorded for undo/redo and reported through `onLocalOps` (to the socket)
+// - Remote edits are applied silently
+// Mirrors the server's op format: add / update / remove / clear.
+
+export class ObjectStore {
+  constructor({ onLocalOps } = {}) {
+    this.objects = new Map();
+    this.version = 0;
+    this.listeners = new Set();
+    this.undoStack = [];
+    this.redoStack = [];
+    this.onLocalOps = onLocalOps || (() => {});
+    this._cache = null;
+  }
+
+  /* --- subscription (compatible with useSyncExternalStore) --- */
+  subscribe = (fn) => {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  };
+  getVersion = () => this.version;
+  _changed() {
+    this.version++;
+    this._cache = null;
+    this.listeners.forEach((fn) => fn());
+  }
+
+  list() {
+    if (!this._cache) this._cache = [...this.objects.values()];
+    return this._cache;
+  }
+  get(id) {
+    return this.objects.get(id);
+  }
+  onPage(page) {
+    return this.list().filter((o) => (o.page ?? 0) === page);
+  }
+
+  /** Replace everything (used for the initial room-state sync). Clears history. */
+  reset(list = []) {
+    this.objects = new Map();
+    for (const o of list) if (o && o.id && !o.removed) this.objects.set(o.id, o);
+    this.undoStack = [];
+    this.redoStack = [];
+    this._changed();
+  }
+
+  /* --- raw application --- */
+  _applyOp(op) {
+    switch (op.op) {
+      case "add":
+        this.objects.set(op.obj.id, op.obj);
+        break;
+      case "update": {
+        const cur = this.objects.get(op.id);
+        if (cur) this.objects.set(op.id, { ...cur, ...op.patch });
+        break;
+      }
+      case "remove":
+        this.objects.delete(op.id);
+        break;
+      case "clear":
+        for (const [id, o] of this.objects) {
+          if (op.page === undefined || (o.page ?? 0) === op.page) this.objects.delete(id);
+        }
+        break;
+      default:
+        break;
+    }
+  }
+
+  /** Compute the ops that would undo `ops`, using the current state. */
+  _inverse(ops) {
+    const inverse = [];
+    // Work on a scratch copy so sequences like add+update invert correctly
+    const scratch = new Map(this.objects);
+    for (const op of ops) {
+      switch (op.op) {
+        case "add":
+          if (scratch.has(op.obj.id)) inverse.unshift({ op: "update", id: op.obj.id, patch: pick(scratch.get(op.obj.id), Object.keys(op.obj)) });
+          else inverse.unshift({ op: "remove", id: op.obj.id });
+          scratch.set(op.obj.id, op.obj);
+          break;
+        case "update": {
+          const cur = scratch.get(op.id);
+          if (!cur) break;
+          inverse.unshift({ op: "update", id: op.id, patch: pick(cur, Object.keys(op.patch)) });
+          scratch.set(op.id, { ...cur, ...op.patch });
+          break;
+        }
+        case "remove": {
+          const cur = scratch.get(op.id);
+          if (!cur) break;
+          inverse.unshift({ op: "add", obj: cur });
+          scratch.delete(op.id);
+          break;
+        }
+        case "clear": {
+          const removed = [];
+          for (const [id, o] of scratch) {
+            if (op.page === undefined || (o.page ?? 0) === op.page) {
+              removed.push({ op: "add", obj: o });
+              scratch.delete(id);
+            }
+          }
+          inverse.unshift(...removed);
+          break;
+        }
+        default:
+          break;
+      }
+    }
+    return inverse;
+  }
+
+  /**
+   * Apply a local user action. It is recorded for undo and (unless emit is false)
+   * sent to the network. Pass emit:false for things already streamed (live strokes).
+   */
+  commit(ops, { emit = true } = {}) {
+    if (!ops.length) return;
+    const inverse = this._inverse(ops);
+    ops.forEach((op) => this._applyOp(op));
+    this.undoStack.push({ forward: ops, inverse });
+    if (this.undoStack.length > 200) this.undoStack.shift();
+    this.redoStack = [];
+    this._changed();
+    if (emit) this.onLocalOps(ops);
+  }
+
+  undo() {
+    const entry = this.undoStack.pop();
+    if (!entry) return false;
+    entry.inverse.forEach((op) => this._applyOp(op));
+    this.redoStack.push(entry);
+    this._changed();
+    this.onLocalOps(entry.inverse);
+    return true;
+  }
+
+  redo() {
+    const entry = this.redoStack.pop();
+    if (!entry) return false;
+    entry.forward.forEach((op) => this._applyOp(op));
+    this.undoStack.push(entry);
+    this._changed();
+    this.onLocalOps(entry.forward);
+    return true;
+  }
+
+  get canUndo() {
+    return this.undoStack.length > 0;
+  }
+  get canRedo() {
+    return this.redoStack.length > 0;
+  }
+
+  /** Remote ops from the host (no history, no echo). */
+  applyRemote(ops) {
+    if (!Array.isArray(ops)) return;
+    ops.forEach((op) => this._applyOp(op));
+    this._changed();
+  }
+
+  /** Remote live-stroke chunk: create or extend a stroke as points arrive. */
+  applyRemoteStroke({ id, page, meta, points }) {
+    const cur = this.objects.get(id);
+    if (cur) {
+      this.objects.set(id, { ...cur, points: cur.points.concat(points) });
+    } else if (meta) {
+      this.objects.set(id, {
+        id,
+        type: "stroke",
+        page: page ?? 0,
+        tool: meta.tool,
+        color: meta.color,
+        width: meta.width,
+        opacity: meta.opacity ?? 1,
+        vp: meta.vp,
+        points: points.slice(),
+      });
+    } else {
+      return;
+    }
+    this._changed();
+  }
+}
+
+function pick(obj, keys) {
+  const out = {};
+  for (const k of keys) out[k] = obj[k];
+  return out;
+}
diff --git a/src/board/useAnnotationTools.js b/src/board/useAnnotationTools.js
new file mode 100644
index 0000000..f5f1127
--- /dev/null
+++ b/src/board/useAnnotationTools.js
@@ -0,0 +1,125 @@
+// Shared tool state + keyboard shortcuts for the board and PDF annotation toolbars.
+import { useCallback, useEffect, useMemo, useRef, useState, useSyncExternalStore } from "react";
+import { STYLE_GROUP, defaultStyles } from "./constants.js";
+
+const SHORTCUTS = {
+  board: { v: "select", p: "pen", m: "highlighter", e: "eraser", t: "text", r: "rect", o: "ellipse", d: "diamond", l: "line", a: "arrow", k: "laser" },
+  pdf: { v: "select", h: "highlight", u: "underline", s: "strike", p: "pen", m: "highlighter", e: "eraser", t: "text", r: "rect", o: "ellipse", a: "arrow", k: "laser" },
+};
+
+export function useAnnotationTools({ mode, store, surfaceRef, enabled }) {
+  const [tool, setTool] = useState("select");
+  const [styles, setStyles] = useState(() => defaultStyles(mode));
+  const [selectedIds, setSelectedIds] = useState([]);
+  const [editingObj, setEditingObj] = useState(null);
+  const [keepTool, setKeepTool] = useState(false);
+  const [lastShape, setLastShape] = useState("rect");
+
+  useSyncExternalStore(store.subscribe, store.getVersion);
+
+  const chooseTool = useCallback((t) => {
+    setTool(t);
+    if (["rect", "ellipse", "diamond", "line", "arrow"].includes(t)) setLastShape(t);
+    if (t !== "select") setSelectedIds([]);
+  }, []);
+
+  // Drop selection entries whose objects disappeared (undo, remote clear, ...)
+  const liveSelected = useMemo(
+    () => selectedIds.filter((id) => store.get(id)),
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [selectedIds, store.getVersion()]
+  );
+
+  const selectedObjects = liveSelected.map((id) => store.get(id));
+
+  // Which remembered-style group the panel is editing right now
+  const group = editingObj ? "text"
+    : selectedObjects.length ? groupOf(selectedObjects[0], tool)
+      : STYLE_GROUP[tool] || null;
+
+  const activeStyle = (() => {
+    if (!group) return null;
+    if (editingObj) return { ...styles.text, ...pickText(editingObj) };
+    if (selectedObjects.length) return { ...styles[group], ...pickStyle(selectedObjects[0]) };
+    return styles[group];
+  })();
+
+  const setStyle = useCallback((patch) => {
+    if (!group) return;
+    setStyles((s) => ({ ...s, [group]: { ...s[group], ...patch } }));
+    surfaceRef.current?.patchStyle(patch);
+  }, [group, surfaceRef]);
+
+  // Keyboard shortcuts (host only)
+  const toolsRef = useRef({});
+  toolsRef.current = { chooseTool, store, surfaceRef, selectedIds: liveSelected, setSelectedIds, editingObj };
+
+  useEffect(() => {
+    if (!enabled) return undefined;
+    const map = SHORTCUTS[mode];
+    const onKey = (e) => {
+      const t = e.target;
+      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable)) return;
+      const { chooseTool: choose, store: st, surfaceRef: sr, selectedIds: sel, setSelectedIds: setSel } = toolsRef.current;
+      const mod = e.metaKey || e.ctrlKey;
+      const key = e.key.toLowerCase();
+
+      if (mod && key === "z") {
+        e.preventDefault();
+        if (e.shiftKey) st.redo(); else st.undo();
+        return;
+      }
+      if (mod && key === "y") { e.preventDefault(); st.redo(); return; }
+      if (mod && key === "a") { e.preventDefault(); sr.current?.selectAll(); return; }
+      if (mod && key === "c") { sr.current?.copy(); return; }
+      if (mod && key === "v") { e.preventDefault(); sr.current?.paste(); return; }
+      if (mod && key === "d") { e.preventDefault(); sr.current?.duplicate(); return; }
+      if (mod || e.altKey) return;
+
+      if ((key === "delete" || key === "backspace") && sel.length) {
+        e.preventDefault();
+        sr.current?.deleteSelected();
+        return;
+      }
+      if (key === "escape") {
+        if (sel.length) setSel([]);
+        else choose("select");
+        return;
+      }
+      if (sel.length && key.startsWith("arrow")) {
+        e.preventDefault();
+        const step = e.shiftKey ? 10 : 1;
+        sr.current?.nudge(key === "arrowleft" ? -step : key === "arrowright" ? step : 0, key === "arrowup" ? -step : key === "arrowdown" ? step : 0);
+        return;
+      }
+      if (map[key]) choose(map[key]);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [enabled, mode]);
+
+  return {
+    tool, setTool: chooseTool, styles, setStyle, group, activeStyle,
+    selectedIds: liveSelected, setSelectedIds, selectedObjects,
+    editingObj, setEditingObj, keepTool, setKeepTool, lastShape,
+    canUndo: store.canUndo, canRedo: store.canRedo,
+  };
+}
+
+function groupOf(o, tool) {
+  if (o.type === "stroke") return o.tool === "highlighter" ? "highlighter" : "pen";
+  if (o.type === "shape") return "shape";
+  if (o.type === "text") return "text";
+  if (o.type === "markup") return o.kind === "highlight" ? "markup" : "markupLine";
+  return STYLE_GROUP[tool] || null;
+}
+
+const pickText = (o) => ({ color: o.color, fontFamily: o.fontFamily, fontSize: o.fontSize, bold: o.bold, italic: o.italic, underline: o.underline, align: o.align });
+function pickStyle(o) {
+  if (o.type === "text") return pickText(o);
+  const out = { color: o.color };
+  if (o.width !== undefined) out.width = o.width;
+  if (o.opacity !== undefined) out.opacity = o.opacity;
+  if (o.type === "shape") out.fill = !!o.fill;
+  return out;
+}
