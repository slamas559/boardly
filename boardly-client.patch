+
+export function drawGrid(ctx, view, w, h) {
+  const spacing = 40;
+  const px = spacing * view.k;
+  if (px < 10) return; // too dense when zoomed out
+  const x0 = Math.floor(view.x / spacing) * spacing;
+  const y0 = Math.floor(view.y / spacing) * spacing;
