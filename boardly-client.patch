+  ctx.save();
+  ctx.strokeStyle = o.color || "#000";
+  ctx.fillStyle = o.color || "#000";
+  ctx.lineWidth = width;
+  ctx.lineJoin = "round";
+  ctx.lineCap = "round";
+  ctx.globalAlpha *= o.opacity ?? 1;
