+    case "text": {
+      const m = measureText(o);
+      const x = o.align === "center" ? o.x - m.w / 2 : o.align === "right" ? o.x - m.w : o.x;
+      return { x, y: o.y, w: m.w, h: m.h };
+    }
+    case "markup": {
